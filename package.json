{
  "name": "playwright_demo",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright demo for Katalon True interoperability (Katalian Bank)",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "upload": "playwright-reporter upload --output ./reports --api-key $KATALON_API_KEY --project-id $KATALON_PROJECT_ID"
  },
  "devDependencies": {
    "@katalon/playwright-reporter": "^0.0.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5"
  }
}
